# FLOWSTATE Backend Environment Variables Example
# Copy this file to .env and customize for your local development or production environment.
# DO NOT commit the .env file containing sensitive credentials to version control.

# Application Configuration
APP_NAME=FLOWSTATE
APP_ENV=development
APP_DEBUG=true

# Database Configuration (Supabase PostgreSQL - Shared Pooler)
# Connection Parameters:
# - Host: aws-1-ap-south-1.pooler.supabase.com
# - Port: 5432
# - Database: postgres
# - User: postgres.bpcubzxhphdvzhxanpse
#
# NOTE: If your database password contains special characters, percent-encode them
# (e.g., '@' -> '%40', '#' -> '%23', '!' -> '%21', '$' -> '%24').
DATABASE_URL=postgresql://postgres.bpcubzxhphdvzhxanpse:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:3000

# Security (JWT & Session Encryption Secret Key)
# Generate a strong 32+ character random string for production
SECRET_KEY=

# Supabase Auth & JWT Verification Configuration
# Find your JWT Secret in: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_URL=https://bpcubzxhphdvzhxanpse.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
# Service role key (optional, strictly server-side, NEVER exposed to client)
SUPABASE_SERVICE_ROLE_KEY=
